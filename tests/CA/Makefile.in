SHELL=@SHELL@
srcdir=@srcdir@


all:


clean: ldap_clean
	-rm -fr ca-test/
	-rm -f testhostkey_* testid_* selfid_* testocsp_*
	-rm -f ca-?.log ca-3.*.log va-*.log sshd_x509.log
	-rm -f sshd_x509.log .sshd_x509.pid sshd_config-certTests
	-rm -f ssh_config-certTests .ssh_x509.err.log .ssh_x509.reply
	-rm -f ssh_askpass-* nsspassfile
	-rm -f pkcs11_tool-*-*.der .ssh-module.log
	-rm -f ssh_engine openssl_engine.cnf openssl_provider.cnf
	-rm -rf softhsm nssdb tpm2


distclean: clean
	-rm -f Makefile

# ===

check-certs: ca_files hostkeys identities selfidentities ocsp_certs crl_files ldap_files
	@echo
	$(SHELL) $(srcdir)/ssh_x509tests.sh

# ===
ca_files: ca-test/catest.config ca-test/catest-bundle.crt

#user is responsible to recreate X.509 tests files !!!
#ca-test/catest.config: $(srcdir)/config
ca-test/catest.config:
	@echo
	$(SHELL) $(srcdir)/1-cre_cadb.sh

ca-test/catest-bundle.crt: ca-test/catest.config
	@echo
	$(SHELL) $(srcdir)/2-cre_cakeys.sh

# ===
GENTYPE =
GENCAT =
GENFILE =

gen_cert:
	@test -n "$(GENFILE)"
	@rm -f $(GENFILE).certstamp
	@$(SHELL) $(srcdir)/2-cre_key.sh $(GENTYPE) $(GENCAT) $(GENFILE)
	@$(SHELL) $(srcdir)/3-cre_certs.sh $(GENTYPE) $(GENCAT) $(GENFILE)
	@> $(GENFILE).certstamp

# ===
hostkeys: testhostkey_rsa.certstamp
@COMMENT_OUT_DSA@hostkeys: testhostkey_dsa.certstamp
@COMMENT_OUT_ECC256@hostkeys: testhostkey_eccnistp256.certstamp
@COMMENT_OUT_ECC384@hostkeys: testhostkey_eccnistp384.certstamp
@COMMENT_OUT_ECC521@hostkeys: testhostkey_eccnistp521.certstamp
@COMMENT_OUT_ED25519@hostkeys: testhostkey_ed25519.certstamp

testhost_gen:
	@GENCAT=server $(MAKE) -e gen_cert

testhostkey_rsa.certstamp: ca-test/catest-bundle.crt
	@GENTYPE=rsa GENFILE=testhostkey_rsa $(MAKE) -e testhost_gen

testhostkey_dsa.certstamp: ca-test/catest-bundle.crt
	@GENTYPE=dsa GENFILE=testhostkey_dsa $(MAKE) -e testhost_gen

testhostkey_eccnistp256.certstamp: ca-test/catest-bundle.crt
	@GENTYPE=ec256 GENFILE=testhostkey_eccnistp256 $(MAKE) -e testhost_gen

testhostkey_eccnistp384.certstamp: ca-test/catest-bundle.crt
	@GENTYPE=ec384 GENFILE=testhostkey_eccnistp384 $(MAKE) -e testhost_gen

testhostkey_eccnistp521.certstamp: ca-test/catest-bundle.crt
	@GENTYPE=ec521 GENFILE=testhostkey_eccnistp521 $(MAKE) -e testhost_gen

testhostkey_ed25519.certstamp: ca-test/catest-bundle.crt
	@GENTYPE=ed25519 GENFILE=testhostkey_ed25519 $(MAKE) -e testhost_gen

# ===
identities: testid_rsa.certstamp
@COMMENT_OUT_DSA@identities: testid_dsa.certstamp
@COMMENT_OUT_ECC256@identities: testid_eccnistp256.certstamp
@COMMENT_OUT_ECC384@identities: testid_eccnistp384.certstamp
@COMMENT_OUT_ECC521@identities: testid_eccnistp521.certstamp
@COMMENT_OUT_ED25519@identities: testid_ed25519.certstamp

testid_gen:
	@GENCAT=client $(MAKE) -e gen_cert

testid_rsa.certstamp: ca-test/catest-bundle.crt
	@GENTYPE=rsa GENFILE=testid_rsa $(MAKE) -e testid_gen

testid_dsa.certstamp: ca-test/catest-bundle.crt
	@GENTYPE=dsa GENFILE=testid_dsa $(MAKE) -e testid_gen

testid_eccnistp256.certstamp: ca-test/catest-bundle.crt
	@GENTYPE=ec256 GENFILE=testid_eccnistp256 $(MAKE) -e testid_gen

testid_eccnistp384.certstamp: ca-test/catest-bundle.crt
	@GENTYPE=ec384 GENFILE=testid_eccnistp384 $(MAKE) -e testid_gen

testid_eccnistp521.certstamp: ca-test/catest-bundle.crt
	@GENTYPE=ec521 GENFILE=testid_eccnistp521 $(MAKE) -e testid_gen

testid_ed25519.certstamp: ca-test/catest-bundle.crt
	@GENTYPE=ed25519 GENFILE=testid_ed25519 $(MAKE) -e testid_gen

# ===
selfidentities: selfid_rsa.certstamp
@COMMENT_OUT_DSA@selfidentities: selfid_dsa.certstamp
@COMMENT_OUT_ECC256@selfidentities: selfid_eccnistp256.certstamp

testself_gen:
	@GENCAT=self $(MAKE) -e gen_cert

selfid_rsa.certstamp:
	@GENTYPE=rsa GENFILE=selfid_rsa $(MAKE) -e testself_gen

selfid_dsa.certstamp:
	@GENTYPE=dsa GENFILE=selfid_dsa $(MAKE) -e testself_gen

selfid_eccnistp256.certstamp:
	@GENTYPE=ec256 GENFILE=selfid_eccnistp256 $(MAKE) -e testself_gen

# ===
@OCSP_OFF@ocsp_certs:
@OCSP_ON@ocsp_certs: testocsp_rsa.certstamp
@OCSP_ON@@COMMENT_OUT_DSA@ocsp_certs: testocsp_dsa.certstamp
@OCSP_ON@@COMMENT_OUT_ECC256@ocsp_certs: testocsp_eccnistp256.certstamp
@OCSP_ON@@COMMENT_OUT_ECC384@ocsp_certs: testocsp_eccnistp384.certstamp
@OCSP_ON@@COMMENT_OUT_ECC521@ocsp_certs: testocsp_eccnistp521.certstamp
@OCSP_ON@@COMMENT_OUT_ED25519@ocsp_certs: testocsp_ed25519.certstamp

testocsp_gen:
	@GENCAT=ocsp $(MAKE) -e gen_cert

testocsp_rsa.certstamp: ca-test/catest-bundle.crt
	@GENTYPE=rsa GENFILE=testocsp_rsa $(MAKE) -e testocsp_gen

testocsp_dsa.certstamp: ca-test/catest-bundle.crt
	@GENTYPE=dsa GENFILE=testocsp_dsa $(MAKE) -e testocsp_gen

testocsp_eccnistp256.certstamp: ca-test/catest-bundle.crt
	@GENTYPE=ec256 GENFILE=testocsp_eccnistp256 $(MAKE) -e testocsp_gen

testocsp_eccnistp384.certstamp: ca-test/catest-bundle.crt
	@GENTYPE=ec384 GENFILE=testocsp_eccnistp384 $(MAKE) -e testocsp_gen

testocsp_eccnistp521.certstamp: ca-test/catest-bundle.crt
	@GENTYPE=ec521 GENFILE=testocsp_eccnistp521 $(MAKE) -e testocsp_gen

testocsp_ed25519.certstamp: ca-test/catest-bundle.crt
	@GENTYPE=ed25519 GENFILE=testocsp_ed25519 $(MAKE) -e testocsp_gen

# ===
crl_files: ca-test/catest-bundle.crl

ca-test/catest-bundle.crl:
	@echo
	$(SHELL) $(srcdir)/4-cre_crls.sh

# ===
@LDAP_OFF@ldap_files:
@LDAP_ON@ldap_files: ldap/base.ldif

@LDAP_ON@ldap/base.ldif:
@LDAP_ON@	@echo
@LDAP_ON@	$(SHELL) $(srcdir)/5-cre_ldap.sh

@LDAP_OFF@ldap_clean:
@LDAP_ON@ldap_clean:
@LDAP_ON@	-rm -f ldap_setup.log
@LDAP_ON@	-rm -fr ldap
